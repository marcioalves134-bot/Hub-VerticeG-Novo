# Configuração do Hub Vértice G (copie para .env se quiser mudar algo).

# Servidor — por padrão só neste computador.
HUB_HOST=127.0.0.1
HUB_PORT=3200

# Onde fica o banco do Hub (padrão: ./data/hub.db).
# HUB_DB_PATH=

# Horas de validade da sessão (padrão: 10).
# HUB_SESSAO_HORAS=10

# Backup automático (npm run backup): pasta no servidor — caminho de rede completo, não letra de unidade.
# HUB_BACKUP_DESTINO=\\servidor\pasta\Backup Hub Vertice G\Hub-VerticeG-Novo\automaticos
# Fila local para quando o servidor estiver fora (padrão: %LOCALAPPDATA%\Hub Vertice G\backups-pendentes).
# HUB_BACKUP_FILA=
